# =====================================================================
# Airflow ETL Project - .gitignore
# =====================================================================

airflow-project-playbook.md

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Environment Variables & Secrets ---
.env
*.env.local
*.pem
*.key
*.cert
credentials.json
secrets.json

# --- Airflow Runtime Artifacts & Logs ---
airflow.cfg
airflow.db
webserver_config.py
logs/
*.log
*.pid

# --- Local Staging & Sync Directories ---
# Dynamic DAG directory generated by ./sync and ./watcher
enabled_dags/

# Local data staging, temporary batch files, local SQLite DBs
staging/
*.db
*.sqlite
*.sqlite3

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Operating System Files ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# --- IDE & Editor Files ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
